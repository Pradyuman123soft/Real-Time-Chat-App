# Client / next.js environment variables
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ChatApp?retryWrites=true&w=majority
NEXT_PUBLIC_URL=https://your-frontend-domain.com
NEXT_PUBLIC_SOCKET_URL=https://your-backend-domain.com
NEXTAUTH_URL=https://your-frontend-domain.com
NEXTAUTH_SECRET=replace-with-a-secure-secret
JWT_SECRET=replace-with-a-secure-secret
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret
